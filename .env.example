# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/brewflow
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=generate_a_long_random_string
JWT_EXPIRES_IN=7d
TAX_RATE=0.08

# PayHere sandbox — never expose PAYHERE_MERCHANT_SECRET to the frontend
PAYHERE_MERCHANT_ID=your_sandbox_merchant_id
PAYHERE_MERCHANT_SECRET=your_sandbox_merchant_secret
PAYHERE_CURRENCY=LKR
PAYHERE_CHECKOUT_URL=https://sandbox.payhere.lk/pay/checkout
# notify_url must be publicly reachable (use a tunnel in local dev)
PAYHERE_NOTIFY_URL=https://your-public-host/api/payments/notify
PAYHERE_RETURN_URL=http://localhost:5173/checkout/return
PAYHERE_CANCEL_URL=http://localhost:5173/checkout/cancel
